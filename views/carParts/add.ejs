<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>انشاء جزء جديد</h1>


    <form action="/parts/add" method="post" enctype="multipart/form-data">
        <label>التعديل:</label>
        <select name="modification" required>
            <% modifications.forEach(mod => { %>
                <option value="<%= mod._id %>"> <%= mod.model.model %> </option>
                <% } ) %>
        </select>
        <br><br>


        <label>صورة الجزء: </label>
        <input type="file" name="part_image" accept="image/*" required>
        <br><br>

        <button type="submit"> اضافة</button>

    </form>
</body>
</html>