<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>اضافة تعديل</h1>


    <form action="/modifications/add" method="post" enctype="multipart/form-data">
        <label>الموديل:</label>
        <select name="model" > 
            <% models.forEach(model => { %>
                <option value="<%= model._id %>"><%= model.model %></option>
                <% }) %>
        </select>
        <br><br>


        <label> صورة قبل التعديل </label>
        <input type="file" name="before_image" accept="image/*" required>
        <br><br>

        <label> صورة بعد التعديل</label>
        <input type="file" name="after_image" accept="image/*" required>
        <br><br>

        <button type="submit">اضافة</button>
    </form>
</body>
</html>